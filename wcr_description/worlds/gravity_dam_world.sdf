<?xml version="1.0" ?>
<!-- Generated by tools/build_gravity_dam_world.py - do not edit by hand.
     Dam model: "Gravity Dam" by USACE Sacramento District, CC-BY-4.0. -->
<sdf version="1.8">
  <world name="gravity_dam_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.42 0.43 0.46 1</ambient>
      <background>0.62 0.74 0.88 1</background>
      <!-- off: ogre (v1) shadow maps give striped "shadow acne" that shimmers when the view moves -->
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>
    <!-- sun in front of the downstream (front) face, high and from the left, so the piers,
         gates and powerhouse are lit from the side and keep their shape -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>15 40 40 0 0 0</pose>
      <diffuse>1.0 0.97 0.92 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 -0.6 -0.72</direction>
    </light>
    <!-- weak fill from the upstream side so the back face is not black -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 -40 30 0 0 0</pose>
      <diffuse>0.35 0.37 0.42 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.2 0.7 -0.5</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>200 200 1</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <!-- visual top 5 cm below the dam base: coincident surfaces z-fight (shimmer) -->
        <visual name="v">
          <pose>0 0 -0.55 0 0 0</pose>
          <geometry><box><size>200 200 1</size></box></geometry>
          <material><ambient>0.42 0.40 0.36 1</ambient><diffuse>0.48 0.46 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gravity_dam">
      <static>true</static>
      <link name="body">
        <visual name="model">
          <geometry><mesh><uri>package://wcr_description/worlds/meshes/gravity_dam/gravity_dam.obj</uri></mesh></geometry>
        </visual>
        <!-- climbing face: the vertical upstream face, plane y = 0 -->
        <collision name="upstream_face">
          <pose>0 0.5 6.5109 0 0 0</pose>
          <geometry><box><size>29.096 1.0 13.0217</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <!-- crest: stops the robot at the top edge -->
        <collision name="crest">
          <pose>0 5.949 12.722 0 0 0</pose>
          <geometry><box><size>29.096 11.898 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <!-- front (downstream) climbing strip beside the spillway: 79 deg face, 87 deg upper face, slab -->
        <collision name="front_face">
          <pose>10.6500 4.5939 5.7514 1.378843 0 3.141593</pose>
          <geometry><box><size>7.500 7.2701 0.600</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <collision name="front_upper_face">
          <pose>10.6500 3.8325 10.7613 1.520943 0 3.141593</pose>
          <geometry><box><size>7.500 2.9003 0.600</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <collision name="front_slab">
          <pose>10.650 8.740 1.990 0 0 0</pose>
          <geometry><box><size>7.500 6.316 0.5</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Deployment cradles: ledges the robot rests on until adhesion is on (front = default spawn). -->
    <model name="cradle_front"><static>true</static><pose>10.6500 5.4197 3.0749 1.378843 0 3.141593</pose><link name="ledge"><collision name="c"><pose>0 -0.01 0.03 0 0 0</pose><geometry><box><size>0.45 0.02 0.06</size></box></geometry></collision><visual name="v"><pose>0 -0.01 0.03 0 0 0</pose><geometry><box><size>0.45 0.02 0.06</size></box></geometry><material><ambient>0.9 0.6 0.05 1</ambient><diffuse>0.9 0.6 0.05 1</diffuse></material></visual></link></model>
    <model name="cradle">
      <static>true</static>
      <pose>0 -0.03 0.8401 0 0 0</pose>
      <link name="ledge">
        <collision name="c"><geometry><box><size>0.45 0.06 0.02</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.06 0.02</size></box></geometry>
          <material><ambient>0.9 0.6 0.05 1</ambient><diffuse>0.9 0.6 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Fixed overview camera on the spawn area (1 Hz; for screenshots and docs) -->
    <model name="overview_camera">
      <static>true</static>
      <pose>13.2 10.2 4.6 0 0.22 -2.0</pose>
      <link name="link">
        <sensor name="overview" type="camera">
          <update_rate>1</update_rate>
          <always_on>true</always_on>
          <topic>/overview/image</topic>
          <camera><horizontal_fov>1.0</horizontal_fov><image><width>1280</width><height>720</height></image>
            <clip><near>0.05</near><far>300</far></clip></camera>
        </sensor>
      </link>
    </model>

    <gui fullscreen="0">
      <!-- MinimalScene (not the deprecated GzScene3D, which ignores camera_clip): its ~1 cm default
           near clip leaves too little depth precision at 15-30 m and stacked surfaces shimmer.
           (A segfault printed when the GUI closes is a known Fortress shutdown issue.) -->
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.62 0.66</ambient_light>
        <background_color>0.62 0.74 0.88</background_color>
        <camera_pose>17 18 7 0 0.22 -2.05</camera_pose>
        <camera_clip><near>0.1</near><far>300</far></camera_clip>
      </plugin>
      <!-- helper plugins MinimalScene needs (scene updates, mouse control, selection, follow) -->
      <plugin filename="GzSceneManager" name="Scene Manager"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="CameraTracking" name="Camera Tracking"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="MarkerManager" name="Marker manager"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="SelectEntities" name="Select Entities"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities"><ignition-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></ignition-gui></plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui><title>World control</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">72</property>
          <property type="double" key="width">121</property><property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <ignition-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property><property type="double" key="height">110</property>
          <property type="double" key="width">290</property><property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </ignition-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
  </world>
</sdf>
