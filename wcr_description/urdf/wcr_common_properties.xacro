<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Realistic Industrial / Military Aerospace Palette -->
    <material name="gray">
        <!-- Stealth Matte Carbon Chassis -->
        <color rgba="0.18 0.19 0.22 1.0"/>
    </material>

    <material name="red">
        <!-- Titanium / Gunmetal Steering Knuckles -->
        <color rgba="0.65 0.68 0.72 1.0"/>
    </material>

    <material name="green">
        <!-- Heavy-Duty Dark Rubber Tires -->
        <color rgba="0.10 0.10 0.12 1.0"/>
    </material>

    <material name="yellow">
        <!-- Industrial Hazard Accent -->
        <color rgba="0.95 0.75 0.05 1.0"/>
    </material>

    <material name="blue">
        <!-- High-Velocity EDF Turbine Core (Aerospace Cyan/Blue) -->
        <color rgba="0.05 0.55 0.88 1.0"/>
    </material>

    <material name="turquoise">
        <!-- Precision Aero Propellers -->
        <color rgba="0.08 0.65 0.90 1.0"/>
    </material>

</robot>