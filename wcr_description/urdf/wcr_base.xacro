<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- xacro properties can be found in wcr_params.xacro -->
    <xacro:macro name="inertial_properties" params="mass ixx iyy izz">
        <inertial>
            <mass value="${mass}"/>
            <inertia ixx="${ixx}" ixy="0.0" ixz="0.0" iyy="${iyy}" iyz="0.0" izz="${izz}"/>
        </inertial>
    </xacro:macro>

    <!-- BASE LINK (on the wheel contact plane) -->

    <link name="base_link">
    </link>

    <!-- OPTITRACK LINK -->

    <joint name="optitrack_joint" type="fixed">
        <parent link="base_link"/>
        <child link="optitrack_link"/>
        <origin xyz="0 0 0.120"/> <!--140 mjerenjem, 120 iz optitrack-a-->
    </joint>


    <link name="optitrack_link">
    </link>

    <!-- IMU LINK -->

    <joint name="imu_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="imu_link"/>
        <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
    </joint>


    <link name="imu_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.005"/>
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
    </link>

    <!-- BAROMETER LINK -->

    <joint name="barometer_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="barometer_link"/>
        <origin xyz="${barometer_x} ${barometer_y} ${barometer_z}" rpy="${barometer_roll} ${barometer_pitch} ${barometer_yaw}"/>
    </joint>

    <link name="barometer_link">
    </link>

    <!-- T265 LINK -->

    <joint name="camera_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="t265_link"/>
        <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
    </joint>


    <link name="t265_link">
    </link>

    <!-- OPTICAL FLOW LINK -->

    <joint name="optical_flow_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="optical_flow_link"/>
        <origin xyz="${optical_flow_x} ${optical_flow_y} ${optical_flow_z}" rpy="${optical_flow_roll} ${optical_flow_pitch} ${optical_flow_yaw}"/>
    </joint>

    <link name="optical_flow_link">
    </link>

    <!-- T265 ODOM -->

    <joint name="camera_odom_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="t265_odom_frame"/>
        <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
    </joint>


    <link name="t265_odom_frame">
    </link>

    <!-- MARVELMIND LINK -->

    <joint name="marvelmind_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="marvelmind_link"/>
        <origin xyz="-0.1223 0.000 0.1205"/>
    </joint>


    <link name="marvelmind_link">
    </link>

    <!-- DISTANCE SENSOR LINK -->

    <joint name="distance_sensor_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="distance_sensor_link"/>
        <origin xyz="${distance_sensor_x} ${distance_sensor_y} ${distance_sensor_z}" rpy="${distance_sensor_roll} ${distance_sensor_pitch} ${distance_sensor_yaw}"/>
    </joint>

    <link name="distance_sensor_link">
    </link>

    <!-- CHASSIS LINK-->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="0 0 0.0103600017"/>
    </joint>


    <!-- Visual: full-detail CAD export, side propeller motors removed (tools/clean_chassis.py).
         Collision: boxes only; mesh collisions make wheel contact slow and jittery. -->
    <link name="chassis_link">
        <inertial>
            <origin xyz="${chassis_com_x} ${chassis_com_y} ${chassis_com_z}"/>
            <mass value="${chassis_mass}"/>
            <inertia ixx="${chassis_ixx}" ixy="0.0" ixz="0.0" iyy="${chassis_iyy}" iyz="0.0" izz="${chassis_izz}"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/${chassis_mesh}" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <!-- EDF skirt (bottom 9.6 mm above the contact plane) -->
        <collision name="skirt">
            <origin xyz="0 0 0.040" rpy="0 0 0"/>
            <geometry>
                <box size="0.174 0.175 0.080"/>
            </geometry>
        </collision>
        <!-- deck, servos and electronics -->
        <collision name="deck">
            <origin xyz="0.0085 0 0.095" rpy="0 0 0"/>
            <geometry>
                <box size="0.317 0.265 0.070"/>
            </geometry>
        </collision>
    </link>

    <!-- EDF ROTOR: axis points into the surface, so positive thrust presses the robot on.
         The Thruster command is the total adhesion force (fan thrust + skirt suction). -->

    <joint name="EDF_propeller_joint" type="continuous">
        <parent link="chassis_link"/>
        <child link="EDF_propeller_link"/>
        <axis xyz="0 0 -1"/>
        <origin xyz="0 0 0"/>
    </joint>

    <link name="EDF_propeller_link">
        <inertial>
            <origin xyz="0 0 0.040"/>
            <mass value="${edf_mass}"/>
            <inertia ixx="${edf_i}" ixy="0.0" ixz="0.0" iyy="${edf_i}" iyz="0.0" izz="${edf_i}"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/edfProp.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <!-- SIDE PROPELLERS (original design; removed from the dam robot) -->

    <xacro:if value="${side_propellers}">
    <joint name="FL_propeller_joint" type="continuous">
        <parent link="chassis_link"/>
        <child link="FL_propeller_link"/>
        <axis xyz="-1 0 0"/>
        <origin xyz="${prop_x} ${prop_y} ${prop_height}"/>
    </joint>

    <link name="FL_propeller_link">
        <xacro:inertial_properties mass="${prop_mass}" ixx="${default_inertia}" iyy="${default_inertia}" izz="${default_inertia}"/>
        <visual>
            <origin rpy="0 0 0" xyz="${prop_x} -${prop_y} -${prop_height}"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/prop9Inch.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="turquoise"/>
        </visual>
    </link>

    <joint name="BL_propeller_joint" type="continuous">
        <parent link="chassis_link"/>
        <child link="BL_propeller_link"/>
        <axis xyz="1 0 0"/>
        <origin xyz="-${prop_x} ${prop_y} ${prop_height}"/>
    </joint>

    <link name="BL_propeller_link">
        <xacro:inertial_properties mass="${prop_mass}" ixx="${default_inertia}" iyy="${default_inertia}" izz="${default_inertia}"/>
        <visual>
            <origin rpy="0 0 0" xyz="${prop_x} -${prop_y} -${prop_height}"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/prop9Inch.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="turquoise"/>
        </visual>
    </link>

    <joint name="FR_propeller_joint" type="continuous">
        <parent link="chassis_link"/>
        <child link="FR_propeller_link"/>
        <axis xyz="1 0 0"/>
        <origin xyz="${prop_x} -${prop_y} ${prop_height}"/>
    </joint>

    <link name="FR_propeller_link">
        <xacro:inertial_properties mass="${prop_mass}" ixx="${default_inertia}" iyy="${default_inertia}" izz="${default_inertia}"/>
        <visual>
            <origin rpy="0 0 ${pi}" xyz="-${prop_x} ${prop_y} -${prop_height}"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/prop9Inch.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="turquoise"/>
        </visual>
    </link>

    <joint name="BR_propeller_joint" type="continuous">
        <parent link="chassis_link"/>
        <child link="BR_propeller_link"/>
        <axis xyz="-1 0 0"/>
        <origin xyz="-${prop_x} -${prop_y} ${prop_height}"/>
    </joint>

    <link name="BR_propeller_link">
        <xacro:inertial_properties mass="${prop_mass}" ixx="${default_inertia}" iyy="${default_inertia}" izz="${default_inertia}"/>
        <visual>
            <origin rpy="0 0 ${pi}" xyz="-${prop_x} ${prop_y} -${prop_height}"/>
            <geometry>
                <mesh filename="package://wcr_description/meshes/prop9Inch.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="turquoise"/>
        </visual>
    </link>
    </xacro:if>

    <!-- WHEEL UNITS: steering pod (revolute, z) + driven wheel (continuous, y) -->

    <xacro:macro name="wheel_unit" params="prefix sx sy pod_yaw wheel_rpy">
        <joint name="${prefix}_steering" type="revolute">
            <limit effort="${steering_effort}" lower="${-pi/2}" upper="${pi/2}" velocity="${steering_velocity}"/>
            <parent link="chassis_link"/>
            <child link="${prefix}_steering_link"/>
            <origin xyz="${sx*length/2} ${sy*width/2} ${steering_height}"/>
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_steering_link">
            <xacro:inertial_properties mass="${steering_mass}" ixx="${steering_i}" iyy="${steering_i}" izz="${steering_i}"/>
            <visual>
                <origin rpy="0 0 ${pod_yaw}" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://wcr_description/meshes/active_wheel.obj" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="red"/>
            </visual>
        </link>

        <joint name="${prefix}_wheel" type="continuous">
            <axis xyz="0 1 0"/>
            <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
            <origin xyz="0 0 ${wheel_height}"/>
            <parent link="${prefix}_steering_link"/>
            <child link="${prefix}_wheel_link"/>
        </joint>

        <link name="${prefix}_wheel_link">
            <xacro:inertial_properties mass="${wheel_mass}" ixx="${wheel_i_radial}" iyy="${wheel_i_axial}" izz="${wheel_i_radial}"/>
            <visual>
                <origin rpy="${wheel_rpy}" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://wcr_description/meshes/wheel.obj" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="green"/>
            </visual>
            <collision>
                <origin rpy="${pi/2} 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <xacro:wheel_unit prefix="FL" sx="1" sy="1" pod_yaw="${pi/2}" wheel_rpy="0 ${pi/2} 0"/>
    <xacro:wheel_unit prefix="BL" sx="-1" sy="1" pod_yaw="${pi/2}" wheel_rpy="0 ${pi/2} 0"/>
    <xacro:wheel_unit prefix="BR" sx="-1" sy="-1" pod_yaw="${-pi/2}" wheel_rpy="0 0 ${pi}"/>
    <xacro:wheel_unit prefix="FR" sx="1" sy="-1" pod_yaw="${-pi/2}" wheel_rpy="0 0 ${pi}"/>
</robot>
